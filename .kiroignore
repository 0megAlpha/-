# ==========================================
# 1. 核心機密與環境變數檔案 (最高優先權)
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_eddsa
secrets/
private/
config/secrets.*

# ==========================================
# 2. 雲端與遠端連線憑證 (防止 VPS 被控制)
# ==========================================
.aws/
.kube/
.ssh/
*config.json
*credentials

# ==========================================
# 3. 數據庫與本地快照 (防止資料庫結構或內容外洩)
# ==========================================
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
dump.rdb

# ==========================================
# 4. OpenHands / Agent 運行快照與紀錄
# ==========================================
.openhands/
.config/openhands/
openhands_logs/
workspace_snapshots/

# ==========================================
# 5. 大型依賴與編譯暫存 (避免浪費 AI Token 與效能)
# ==========================================
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.target/
dist/
build/
.kiro/cache/
