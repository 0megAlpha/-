# Merge into ~/.codex/config.toml; keep model and model_provider before table declarations.
model = "gpt-5-codex"
model_provider = "openai-compatible-responses"

[model_providers.openai-compatible-responses]
name = "OpenAI-compatible Responses provider"
base_url = "https://api.openai.com/v1"
env_key = "OPENAI_API_KEY"
wire_api = "responses"
request_max_retries = 4
stream_max_retries = 5
stream_idle_timeout_ms = 300000
