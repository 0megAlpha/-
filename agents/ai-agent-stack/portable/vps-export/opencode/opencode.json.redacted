{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM Gateway",
      "options": { "baseURL": "http://127.0.0.1:4000/v1" },
      "models": {
        "glm-5.2": { "name": "GLM 5.2 (NVIDIA)" },
        "nvidia/meta/llama-3.1-8b-instruct": { "name": "NVIDIA Llama 3.1 8B" },
        "nvidia/deepseek-ai/deepseek-r1": { "name": "NVIDIA DeepSeek R1" },
        "nvidia/qwen/qwen3-32b": { "name": "NVIDIA Qwen3 32B" }
      }
    }
  },
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git", "opencode-linear", "oh-my-openagent@latest"],
  "mcp": {
    "filesystem": { "type": "local", "command": ["mcp-server-filesystem"], "enabled": true },
    "github": { "type": "local", "command": ["mcp-server-github"], "enabled": true },
    "postgres": { "type": "local", "command": ["mcp-server-postgres"], "enabled": true },
    "kubernetes": { "type": "local", "command": ["mcp-server-kubernetes"], "enabled": true },
    "sqlite": { "type": "local", "command": ["mcp-sqlite"], "enabled": true },
    "fetch": { "type": "local", "command": ["mcp-fetch"], "enabled": true },
    "docker": { "type": "local", "command": ["docker-mcp"], "enabled": true },
    "aws": { "type": "local", "command": ["aws-mcp"], "enabled": true }
  },
  "plugins": ["oh-my-opencode", "dsh-hermes-memory"]
}
