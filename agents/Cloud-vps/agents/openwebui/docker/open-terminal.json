{
  "name": "open-terminal",
  "image": "ghcr.io/open-webui/open-terminal",
  "cmd": [
    "run"
  ],
  "entrypoint": [
    "/usr/bin/tini",
    "--",
    "/app/entrypoint.sh"
  ],
  "env_keys": [
    "GPG_KEY",
    "LANG",
    "OPEN_TERMINAL_API_KEY",
    "PATH",
    "PYTHON_SHA256",
    "PYTHON_VERSION",
    "SHELL"
  ],
  "ports": {
    "8000/tcp": [
      {
        "HostIp": "127.0.0.1",
        "HostPort": "8000"
      }
    ]
  },
  "restart": "always",
  "network": "bridge",
  "mounts": [
    {
      "src": "/var/lib/docker/volumes/open-terminal/_data",
      "dst": "/home/user",
      "rw": true
    }
  ],
  "status": "running"
}