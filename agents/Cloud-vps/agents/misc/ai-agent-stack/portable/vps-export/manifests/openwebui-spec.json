{
 "Image": "ghcr.io/open-webui/open-webui:main",
 "Ports": {
  "8080/tcp": [
   {
    "HostIp": "100.x.x.x",
    "HostPort": "8081"
   }
  ]
 },
 "Binds": [
  "/opt/open-webui/data:/app/backend/data"
 ],
 "Restart": {
  "Name": "always",
  "MaximumRetryCount": 0
 },
 "Env": [
  "WEBUI_AUTH=[REDACTED]",
  "ENABLE_SIGNUP=True",
  "DEFAULT_USER_ROLE=admin",
  "PATH=/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
  "LANG=C.UTF-8",
  "GPG_KEY=[REDACTED]",
  "PYTHON_VERSION=3.11.16",
  "PYTHON_SHA256=91bcdebfdde239a003ae93738a7fce0f9230fee5c4bc2b86f6e6e8c6f98aabe8",
  "PYTHONUNBUFFERED=1",
  "ENV=prod",
  "PORT=8080",
  "USE_OLLAMA_DOCKER=false",
  "USE_CUDA_DOCKER=false",
  "USE_SLIM_DOCKER=false",
  "USE_CUDA_DOCKER_VER=cu128",
  "USE_EMBEDDING_MODEL_DOCKER=sentence-transformers/all-MiniLM-L6-v2",
  "USE_RERANKING_MODEL_DOCKER=",
  "USE_AUXILIARY_EMBEDDING_MODEL_DOCKER=TaylorAI/bge-micro-v2",
  "OLLAMA_BASE_URL=/ollama",
  "OPENAI_API_BASE_URL=",
  "OPENAI_API_KEY=[REDACTED]",
  "WEBUI_SECRET_KEY=[REDACTED]",
  "SCARF_NO_ANALYTICS=true",
  "DO_NOT_TRACK=true",
  "ANONYMIZED_TELEMETRY=false",
  "WHISPER_MODEL=base",
  "WHISPER_MODEL_DIR=/app/backend/data/cache/whisper/models",
  "RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2",
  "RAG_RERANKING_MODEL=",
  "AUXILIARY_EMBEDDING_MODEL=TaylorAI/bge-micro-v2",
  "SENTENCE_TRANSFORMERS_HOME=/app/backend/data/cache/embedding/models",
  "TIKTOKEN_ENCODING_NAME=[REDACTED]",
  "TIKTOKEN_CACHE_DIR=[REDACTED]",
  "HF_HOME=/app/backend/data/cache/embedding/models",
  "HOME=/root",
  "UV_LINK_MODE=copy",
  "WEBUI_BUILD_VERSION=0a7c15832fb30b1903753e83f81dc7d27e5b0944",
  "DOCKER=true"
 ]
}
