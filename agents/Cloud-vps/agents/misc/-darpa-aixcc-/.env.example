# 通过本地 LiteLLM 网关调用 (如果你已在 LiteLLM 中配置 NVIDIA 呼叫 GLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 如果 LiteLLM 没配置，想直连 NVIDIA 原生端点，则注释上面，用下面这三行：
# OPENAI_API_KEY=REDACTED
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=meta/llama-3.1-70b-instruct

FUZZINGBRAIN_BUDGET_LIMIT=
LLM_TIMEOUT=
LLM_MAX_RETRIES=
