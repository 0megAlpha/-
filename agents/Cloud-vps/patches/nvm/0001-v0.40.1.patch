+
+nvm alias test-stable-1 0.0.1 || die '`nvm alias test-stable-1 0.0.1` failed'
+
+OUTPUT="$(nvm alias test-stable-1 | strip_colors)"
+EXPECTED_OUTPUT='test-stable-1 -> 0.0.1 (-> v0.0.1)'
