+[ "_$EXIT_CODE" = "_0" ] || die "expected 'nvm_ensure_version_installed system' with node installed to exit with 0, got $EXIT_CODE"
+
+nvm_has_system_node() { return 1; }
+nvm_has_system_iojs() { return 0; }
