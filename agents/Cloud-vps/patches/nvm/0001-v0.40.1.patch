+nvm_match_version() {
+  local NVM_IOJS_PREFIX
+  NVM_IOJS_PREFIX="$(nvm_iojs_prefix)"
+  local PROVIDED_VERSION
+  PROVIDED_VERSION="$1"
+  case "_${PROVIDED_VERSION}" in
+    "_${NVM_IOJS_PREFIX}" | '_io.js')
+      nvm_version "${NVM_IOJS_PREFIX}"
+    ;;
+    '_system')
+      nvm_echo 'system'
+    ;;
+    *)
+      nvm_version "${PROVIDED_VERSION}"
+    ;;
+  esac
+}
