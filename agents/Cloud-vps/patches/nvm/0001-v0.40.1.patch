+[ "${IOJS_VERSION}" = "${EXPECTED_OUTPUT}" ] || die "iojs version was not >${EXPECTED_OUTPUT}; got >${IOJS_VERSION}<"
+
+nvm use --delete-prefix iojs || die '`nvm use iojs` failed'
+
