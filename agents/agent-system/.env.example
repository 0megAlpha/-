# ==========================================
# 1. 核心 LLM 與 Gateway 設定
# ==========================================
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_MASTER_KEY=YOUR_LITELLM_MASTER_KEY_HERE
LITELLM_MODEL=openai/glm-5.2
LLM_TIMEOUT=120
MOCK_LLM=0

# ==========================================
# 2. VPS 與網路伺服器設定（一律 localhost / 佔位符）
# ==========================================
VPS_SERVER_IP=127.0.0.1
VPS_HTTP_PORT=8080
VPS_WEBSOCKET_PORT=8081

# ==========================================
# 3. GitHub & CI/CD 設定
# ==========================================
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE
GITHUB_REPO_OWNER=YOUR_GITHUB_USERNAME
GITHUB_REPO_NAME=YOUR_REPO_NAME

# ==========================================
# 4. Agent 專屬憑證與第三方整合
# ==========================================
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
META_ACCESS_TOKEN=YOUR_META_ACCESS_TOKEN_HERE
DATABASE_URL=postgresql://user:password@localhost:5432/agent_db
REDIS_URL=redis://localhost:6379/0
