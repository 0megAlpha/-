# Your patch layer for this dsh profile, applied after every bundle layer:
# a top-level YAML array of loader patch entries (id-targeted config
# overrides, disables, and insert lists; `!!js` expressions allowed).
# NOTE: all plugin ids below are already provided by the profile bundles
# (package.json -> dsh.profile.bundles), so no duplicate inserts are made.
# This file only carries config overrides.

# Force maximum autonomy for the Lody Agent (matches bundle defaults explicitly)
- id: sandbox-policy
  config:
    mode: 'danger-full-access'
- id: approval
  config:
    policy: 'never'