 is released under the [Apache License Version 2.0.](http://www.apache.org/licenses/).\n","_source_registry_name":"default","bugs":{"url":"https://github.com/SAP/ai-sdk-js/issues"},"homepage":"https://github.com/SAP/ai-sdk-js#readme","repository":{"url":"git+https://github.com/SAP/ai-sdk-js.git","type":"git","directory":"packages/ai-api"}}