{
  "name": "dsh-profile-web",
  "private": true,
  "dependencies": {
    "@howmp/dsh-pentest": "https://github.com/howmp/dsh-pentest/releases/latest/download/dsh-pentest.tar.gz",
    "@yejiming/dsh-data-agent": "file:/tmp/dsh-data-agent.tgz",
    "dsh-better-reasoning-effort": "^0.3.10",
    "dsh-bridge": "0.1.0-rc.17",
    "dsh-codex-subscription": "^2.1.0",
    "dsh-cost-meter": "^1.7.27",
    "dsh-deepseek-balance": "^0.1.0",
    "dsh-hermes-memory": "^1.1.10",
    "dsh-mcp-bridge": "^0.1.3",
    "dsh-pentester": "^4.0.0",
    "dsh-streaming-mcp-bridge": "^0.1.1",
    "upstream-radar": "^0.45.0"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "dsh-hermes-memory",
        "dsh-better-reasoning-effort",
        "dsh-bridge",
        "dsh-codex-subscription",
        "dsh-deepseek-balance",
        "dsh-mcp-bridge",
        "dsh-pentester",
        "dsh-streaming-mcp-bridge",
        "upstream-radar",
        "@howmp/dsh-pentest",
        "@yejiming/dsh-data-agent",
        "dsh-cost-meter"
      ],
      "patchReload": "live"
    }
  }
}