[Unit]
Description=Write a read-only Agent Integration Progress snapshot
After=network.target

[Service]
Type=oneshot
User=root
StateDirectory=agent-integration
StateDirectoryMode=0700
ExecStart=/usr/local/sbin/agent-integration-progress-report.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/agent-integration
