[Unit]
Description=OpenHands private Docker-to-LiteLLM bridge
After=network-online.target docker.service litellm.service
Wants=network-online.target
Requires=docker.service litellm.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/openhands-litellm-bridge.py
Restart=always
RestartSec=2
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
