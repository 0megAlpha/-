-    "get_call_hierarchy": {"priority": 3, "use_for": ["call analysis"]},
-
-    # Priority 4: Code modification
-    "apply_edit": {"priority": 4, "use_for": ["editing"]},
-    "rename_symbol": {"priority": 4, "use_for": ["refactoring"]},
-
-    # Priority 5: Diagnostics
