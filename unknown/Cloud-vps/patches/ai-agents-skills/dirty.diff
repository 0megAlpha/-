-      // ─── Folder picker ───────────────────────────────────────────────────
-      async function loadFromDirHandle(dir) {
-        let trscHandle = null;
-        let vidHandle = null;
-        let stylesHandle = null;
-        let vidPriority = -1;
-        const VIDEO_RX = /\.(mp4|mov|mkv|webm|m4v)$/i;
-        const VIDEO_PRIORITY = { "source.mp4": 3, "footage.mp4": 2 };
-
-        for await (const entry of dir.values()) {
-          if (entry.kind !== "file") continue;
-          if (entry.name === "transcript.json") trscHandle = entry;
-          else if (entry.name === "caption_styles.json") stylesHandle = entry;
-          else if (VIDEO_RX.test(entry.name)) {
-            const p = VIDEO_PRIORITY[entry.name.toLowerCase()] ?? 1;
-            if (p > vidPriority) { vidHandle = entry; vidPriority = p; }
-          }
-        }
-        if (!trscHandle) throw new Error("No transcript.json in this folder.");
-        if (!vidHandle) throw new Error("No video file (.mp4, .mov, .mkv, .webm) found.");
-
-        const trscFile = await trscHandle.getFile();
-        transcript = JSON.parse(await trscFile.text());
-        if (!Array.isArray(transcript)) throw new Error("transcript.json must be an array");
-
-        // Hydrate previously saved style assignments (if present)
-        if (stylesHandle) {
-          try {
-            const sf = await stylesHandle.getFile();
-            const sj = JSON.parse(await sf.text());
-            if (sj && sj.assignments) {
-              Object.entries(sj.assignments).forEach(([k, v]) => {
-                const i = +k;
-                if (transcript[i] && v && v.style) transcript[i].__style = v.style;
-              });
-            }
-          } catch (_) { /* sidecar optional */ }
-        }
-
-        const vidFile = await vidHandle.getFile();
-        videoUrl = URL.createObjectURL(vidFile);
-
-        projectDir = dir;
-        projectDirName = dir.name + "/";
-        pushRecent({
-          id: "folder:" + dir.name,
-          name: dir.name,
-          source: "folder",
-          videoName: vidFile.name,
-          segmentCount: transcript.length,
-          language: detectLang(transcript),
-          transcriptSnapshot: JSON.parse(JSON.stringify(transcript)),
-        });
-        openEditor();
-        toast("Loaded " + projectDirName, {
-          type: "success",
-          sub: transcript.length + " segments • saves write back here",
-        });
-      }
-
-      $("btn-folder").addEventListener("click", async () => {
-        if (!window.showDirectoryPicker) {
-          toast("Folder picker not supported in this browser", {
-            type: "warn",
-            sub: "Use Chrome / Edge 86+ (or Safari 15.2+) — or pick files individually below.",
-          });
-          return;
-        }
-        try {
-          const dir = await window.showDirectoryPicker({ mode: "readwrite" });
-          await loadFromDirHandle(dir);
-        } catch (e) {
-          if (e.name !== "AbortError") toast("Failed to open folder", { type: "error", sub: e.message });
-        }
-      });
-
-      $("start").addEventListener("click", () => {
-        if (!transcript || !videoUrl) return;
-        pushRecent({
-          id: "files:" + (lastTrscName || "transcript.json"),
-          name: lastTrscName ? lastTrscName.replace(/\.json$/, "") : "files",
-          source: "files",
