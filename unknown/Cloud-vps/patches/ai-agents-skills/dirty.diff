-      // ─── Toast notifications ─────────────────────────────────────────────
-      function toast(message, opts = {}) {
-        const t = make("div", { class: "toast" + (opts.type ? " " + opts.type : "") });
-        const title = make("div");
-        const b = make("b", { text: message });
-        title.appendChild(b);
-        t.appendChild(title);
-        if (opts.sub) {
-          t.appendChild(make("div", { class: "sub", text: opts.sub }));
-        }
-        $("toast-stack").appendChild(t);
-        setTimeout(() => {
-          t.classList.add("fading");
-          setTimeout(() => t.remove(), 320);
-        }, opts.duration || 3200);
-      }
