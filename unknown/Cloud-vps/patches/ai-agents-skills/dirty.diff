-def fmt_time(t):
-    h = int(t // 3600)
-    m = int((t % 3600) // 60)
-    s = t - h * 3600 - m * 60
-    cs = int(round((s - int(s)) * 100))
-    sec = int(s)
-    if cs == 100:
-        cs = 0
-        sec += 1
-    return f"{h:01d}:{m:02d}:{sec:02d}.{cs:02d}"
-
