-        function tick() {
-          if (!transcript) { requestAnimationFrame(tick); return; }
-          const t = vid.currentTime;
-          let idx = -1;
-          for (let i = 0; i < transcript.length; i++) {
-            const nextStart = transcript[i + 1] ? transcript[i + 1].start : Infinity;
-            if (t >= transcript[i].start && t < nextStart) { idx = i; break; }
-          }
-          if (idx !== last) {
-            document.querySelectorAll(".segment.active").forEach((s) => s.classList.remove("active"));
-            if (idx >= 0) {
-              const el = document.querySelector('.segment[data-idx="' + idx + '"]');
-              if (el) {
-                el.classList.add("active");
-                const segs = $("segments");
-                const rect = el.getBoundingClientRect();
-                const containerRect = segs.getBoundingClientRect();
-                if (rect.top < containerRect.top || rect.bottom > containerRect.bottom) {
-                  el.scrollIntoView({ block: "center", behavior: "smooth" });
-                }
-              }
-            }
-            last = idx;
-            activeIdx = idx;
-          }
-          requestAnimationFrame(tick);
