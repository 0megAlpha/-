-### Embedded Documents vs References
-
-```typescript
-// ✅ Embed when: Data is read together, doesn't grow unbounded
-const orderSchema = new Schema({
-  customer: {
-    name: String,
-    email: String,
-    address: {
-      street: String,
-      city: String,
-      country: String,
-    },
-  },
-  items: [{
-    product: String,
-    quantity: Number,
-    price: Number,
-  }],
-  total: Number,
-});
-
-// ✅ Reference when: Data is large, shared, or changes independently
-const postSchema = new Schema({
-  title: String,
-  content: String,
-  author: {
-    type: Schema.Types.ObjectId,
-    ref: 'User',
-    required: true,
-  },
-  comments: [{
-    type: Schema.Types.ObjectId,
-    ref: 'Comment',
-  }],
-});
-
-// Populate references
-const post = await Post.findById(id)
-  .populate('author', 'name email')  // Select specific fields
-  .populate({
-    path: 'comments',
-    populate: { path: 'author', select: 'name' },  // Nested populate
-  });
-```
-
-### Virtuals
-```typescript
-const userSchema = new Schema({
-  firstName: String,
-  lastName: String,
-});
-
-// Virtual field (not stored in DB)
-userSchema.virtual('fullName').get(function() {
-  return `${this.firstName} ${this.lastName}`;
-});
-
-// Virtual populate (for reverse references)
-userSchema.virtual('posts', {
-  ref: 'Post',
-  localField: '_id',
-  foreignField: 'author',
-});
-
-// Enable virtuals in JSON
-userSchema.set('toJSON', { virtuals: true });
-userSchema.set('toObject', { virtuals: true });
-```
