-                style = "HE"
-                text = pop + r"\c&H0000E5FF&\t(0,80,\frz-3)\t(80,160,\frz3)\t(160,220,\frz0)}" + clean
-            else:
-                style = "HE"
-                text = pop + r"}" + clean
-            events.append(
