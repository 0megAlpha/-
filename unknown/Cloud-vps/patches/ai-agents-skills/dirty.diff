-.nav-links a.active::after { transform: scaleX(1); }
-.nav-links a.active { opacity: 1; }
-
-/* ---------- Scroll progress ---------- */
-.scroll-progress {
-  position: fixed;
-  top: 0; left: 0; right: 0;
-  height: 2px;
-  z-index: 200;
-  background: rgba(255,255,255,0.06);
