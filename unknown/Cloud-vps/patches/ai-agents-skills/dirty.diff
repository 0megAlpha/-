-def group_words(words):
-    groups, cur = [], []
-    for i, w in enumerate(words):
-        cur.append(w)
-        nxt = words[i + 1] if i + 1 < len(words) else None
-        gap = (nxt["s"] - w["e"]) if nxt else 99
