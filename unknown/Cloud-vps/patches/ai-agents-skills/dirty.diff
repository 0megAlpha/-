-        while (sugg.firstChild) sugg.removeChild(sugg.firstChild);
-        sugg.appendChild(make("em", { text: "Generating suggestion…" }));
-
-        const prompt =
-          "You correct speech-to-text mishears in a Hebrew (sometimes mixed with English) " +
-          "transcript. PRESERVE the speaker's actual words, style, slang and length — only " +
-          "fix Whisper's transcription errors (especially product names like Claude / GitHub / " +
-          "Excalidraw, and Hebrew word confusions). Output ONLY the corrected line, no quotes, " +
-          "no explanation, no preamble.\n\n" +
-          'Previous: "' + prev + '"\nCurrent: "' + seg.text + '"\nNext: "' + next + '"\n\n' +
-          "Corrected current line:";
-
-        try {
-          const reply = await engine.chat.completions.create({
-            messages: [{ role: "user", content: prompt }],
-            max_tokens: 300,
-            temperature: 0.2,
-          });
-          const raw = (reply.choices && reply.choices[0] && reply.choices[0].message && reply.choices[0].message.content) || "";
-          const corrected = raw.trim().replace(/^["'`]|["'`]$/g, "");
