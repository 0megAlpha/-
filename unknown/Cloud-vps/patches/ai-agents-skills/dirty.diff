-      }
-      this.current += diff * 0.22;
-      this.draw(this.current);
-    }
-  }
-
-  // ---------- ParallaxPage (virtual scroll) ----------
-  class ParallaxPage {
-    constructor({ folder, frameCount, scrollBudget = 2800, prefix, padWidth, ext }) {
