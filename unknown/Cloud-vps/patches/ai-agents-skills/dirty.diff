-      // ─── Open editor ─────────────────────────────────────────────────────
-      function openEditor() {
-        const saved = loadAutosave();
-        if (saved && saved.length === transcript.length) {
-          if (confirm("Found unsaved edits from a previous session. Restore?")) {
-            transcript = saved;
-            dirtyCount = transcript.filter((s) => s.__dirty).length;
-          }
-        }
-        $("upload").classList.add("hidden");
-        $("editor").classList.remove("hidden");
-        $("vid").src = videoUrl;
-        renderSegments();
-        startActiveTracking();
-        document.querySelectorAll(".nav-only").forEach((el) => el.classList.remove("hidden"));
-        if (projectDirName) {
-          $("project-chip").classList.remove("hidden");
-          $("project-chip-text").textContent = projectDirName;
-        } else {
-          $("project-chip").classList.add("hidden");
-        }
-        onEditor = true;
-        updateStatus();
-      }
-
-      // ─── Home / back ─────────────────────────────────────────────────────
-      function goHome() {
-        if (!onEditor) return;
-        if (dirtyCount > 0) {
-          if (!confirm("You have " + dirtyCount + " unsaved edits. Go back and lose them?")) return;
-        }
-        $("editor").classList.add("hidden");
-        $("upload").classList.remove("hidden");
-        document.querySelectorAll(".nav-only").forEach((el) => el.classList.add("hidden"));
-        $("project-chip").classList.add("hidden");
-        // Reset state so the upload screen is fresh
-        transcript = null;
-        videoUrl = null;
-        projectDir = null;
-        projectDirName = "";
-        dirtyCount = 0;
-        onEditor = false;
-        $("lbl-trsc").classList.remove("ready");
-        $("lbl-trsc").querySelector(".lbl-text").textContent = "Transcript (.json)";
-        $("lbl-vid").classList.remove("ready");
-        $("lbl-vid").querySelector(".lbl-text").textContent = "Video (.mp4, .mov, .mkv)";
-        $("in-trsc").value = "";
-        $("in-vid").value = "";
-        $("start").classList.remove("ready");
-        $("vid").pause();
-        $("vid").src = "";
-        try { localStorage.removeItem(STORAGE_KEY); } catch {}
-        updateStatus();
-      }
-      $("btn-home").addEventListener("click", goHome);
-      $("brand-home").addEventListener("click", () => { if (onEditor) goHome(); });
-      $("btn-newproject").addEventListener("click", async () => {
-        if (dirtyCount > 0) {
-          if (!confirm("You have " + dirtyCount + " unsaved edits. Discard and load a new project?")) return;
-        }
