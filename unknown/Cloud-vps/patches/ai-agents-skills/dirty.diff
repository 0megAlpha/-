-        })
-    for i, d in enumerate(data):
-        d["e"] = data[i + 1]["s"] if i + 1 < len(data) else round(d["raw_e"] + 0.6, 3)
-        del d["raw_e"]
-    duration = round(data[-1]["e"] + 0.15, 2)
-    return data, duration, external
