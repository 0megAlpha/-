-      // ─── Drag & drop on upload screen ────────────────────────────────────
-      const overlay = $("drop-overlay");
-      const uploadEl = $("upload");
-      let dragDepth = 0;
-      uploadEl.addEventListener("dragenter", (e) => {
-        e.preventDefault();
-        dragDepth++;
-        overlay.classList.add("active");
-      });
-      uploadEl.addEventListener("dragover", (e) => e.preventDefault());
-      uploadEl.addEventListener("dragleave", () => {
-        dragDepth--;
-        if (dragDepth <= 0) {
-          dragDepth = 0;
-          overlay.classList.remove("active");
-        }
-      });
-      uploadEl.addEventListener("drop", async (e) => {
-        e.preventDefault();
-        dragDepth = 0;
-        overlay.classList.remove("active");
-
-        const items = Array.from(e.dataTransfer.items || []);
-        // Try FS Access API getAsFileSystemHandle (Chrome/Edge) — directory drop
-        for (const item of items) {
-          if (typeof item.getAsFileSystemHandle === "function") {
-            try {
-              const handle = await item.getAsFileSystemHandle();
-              if (handle && handle.kind === "directory") {
-                await loadFromDirHandle(handle);
-                return;
-              }
-            } catch (_) {}
-          }
-        }
-        // Fallback: handle dropped files individually
-        const files = Array.from(e.dataTransfer.files || []);
-        let trscFile = null;
-        let vidFile = null;
-        for (const f of files) {
-          if (f.name.endsWith(".json")) trscFile = f;
-          else if (/\.(mp4|mov|mkv|webm|m4v)$/i.test(f.name)) vidFile = f;
-        }
-        if (trscFile) {
-          try {
-            transcript = JSON.parse(await trscFile.text());
-            $("lbl-trsc").classList.add("ready");
-            $("lbl-trsc").querySelector(".lbl-text").textContent = trscFile.name;
-          } catch (err) { toast("Bad transcript.json", { type: "error", sub: err.message }); }
-        }
-        if (vidFile) {
-          videoUrl = URL.createObjectURL(vidFile);
-          $("lbl-vid").classList.add("ready");
-          $("lbl-vid").querySelector(".lbl-text").textContent = vidFile.name;
-        }
-        if (transcript && videoUrl) {
-          openEditor();
-        } else if (!trscFile && !vidFile) {
-          toast("Drop a project folder, or a .json + video file", { type: "warn" });
-        } else {
-          checkReady();
-          updateStatus();
-        }
-      });
