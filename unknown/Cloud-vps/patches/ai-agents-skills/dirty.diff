-  --instance-arn arn:aws:sso:::instance/ssoins-xxxxxxxx \
-  --permission-set-arn arn:aws:sso:::permissionSet/ssoins-xxxxxxxx/ps-xxxxxxxx \
-  --managed-policy-arn arn:aws:iam::aws:policy/AdministratorAccess
