-      // ─── Status helpers ──────────────────────────────────────────────────
-      function setStatus(text, dirty) {
-        const st = $("status");
-        st.textContent = text;
-        st.classList.toggle("dirty", !!dirty);
-      }
-      function updateStatus() {
-        if (!transcript) return setStatus("Pick a project folder to begin", false);
-        if (dirtyCount > 0) setStatus(dirtyCount + " edited · " + transcript.length + " segments", true);
-        else setStatus(transcript.length + " segments", false);
